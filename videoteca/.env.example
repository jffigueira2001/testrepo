# Conta de administrador criada no primeiro arranque (muda a password depois de entrar).
ADMIN_EMAIL=admin@clube.pt
ADMIN_PASSWORD=mudar-esta-password

# Tamanho máximo de cada vídeo, em GB.
MAX_UPLOAD_GB=50

# Velocidade vs. tamanho quando é preciso recodificar (ultrafast, veryfast, medium, slow).
X264_PRESET=veryfast

# Dias até a sessão expirar.
SESSION_DAYS=30

# Com HTTPS (perfil "https" do docker compose, ou outro proxy reverso):
# DOMAIN=videos.meuclube.pt
# SECURE_COOKIES=true
# TRUST_PROXY=1

# Cloudflare Tunnel (perfil "tunnel"): link público sem abrir portas.
# TUNNEL_TOKEN=cole-aqui-o-token-do-tunel
